# Copy this file to `.env` and adjust as needed. All values are optional;
# the defaults below are what the application uses when unset.

# SQLAlchemy database connection string.
DATABASE_URL=sqlite:///./lapvisualizer.db

# Log every SQL statement (useful when debugging).
ECHO_SQL=false

# Largest accepted timing-log upload, in MiB.
MAX_UPLOAD_MB=25
