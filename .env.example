# Copy this file to `.env` (git-ignored) and fill in real values.
# Every variable below is read by the application (pydantic-settings) and,
# where interpolated, by docker-compose.

# --- PostgreSQL (required — the app will not start without these) ---
POSTGRES_USER=lapvisualizer
POSTGRES_PASSWORD=lapvisualizer
POSTGRES_DB=lapvisualizer
# Host/port default to localhost:5432 for host runs. docker-compose sets the
# host to the "db" service automatically, so leave these unset for Docker.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Host port for the db container; change it if 5432 is in use. When running the
# API on the host, also set POSTGRES_PORT to the same value.
# POSTGRES_HOST_PORT=5432

# --- Application ---
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Log every SQL statement (useful when debugging).
ECHO_SQL=false
# Minimum application log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
# Largest accepted timing-log upload, in MiB.
MAX_UPLOAD_MB=25
